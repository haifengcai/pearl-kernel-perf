# 性能/省电向补丁（叠加在设备原配置之上，全部为纯配置项，不改变任何导出结构体，
# 因此不会影响 vendor 模块的 CRC 校验）
#
# 网络：BBR + FQ 让高负载下的延迟明显下降，弱网吞吐更稳（也更省电，避免长时间重传）
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# 编译期：CI 用的是 apt.llvm.org 的 clang 22（设备内核是 AOSP r584948，版本不完全等价），
# 关掉 -Werror，避免新版编译器的告警直接打断编译。纯编译开关，不影响 ABI/vermagic。
# CONFIG_WERROR is not set

# 内存压缩：zram 走 crypto API，lib/zstd 升级后同样受益，这里确保压缩器齐备
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4HC_COMPRESS=y
CONFIG_LZO_COMPRESS=y
